{
  "name": "@teamitfi/js-to-make",
  "version": "1.0.0",
  "license": "MIT",
  "exports": "./main.ts",
  "publish": {
    "exclude": [
      ".git",
      ".github",
      ".gitignore",
      "tests/",
      "package.json",
      "index.ts",
      "Makefile",
      "deno.lock"
    ]
  },
  "tasks": {
    "js-to-make": "deno run --allow-read --allow-write main.ts",
    "install": "deno install --global --allow-read --allow-write --name js-to-make main.ts",
    "test": "deno test"
  },
  "fmt": {
    "exclude": ["**/*.md"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
